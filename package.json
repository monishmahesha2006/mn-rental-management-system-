{
  "name": "blr-rental-platform",
  "version": "1.0.0",
  "description": "Premium Bangalore Rental & Property Management Platform",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build": "npm run build:client && npm run build:server",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "prisma:migrate": "npm run prisma:migrate --prefix server",
    "format-db": "npm run format-db --prefix server",
    "start": "node server/dist/index.js",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client"
  },
  "keywords": [
    "rental",
    "property-management",
    "bangalore",
    "real-estate"
  ],
  "author": "",
  "license": "ISC"
}
