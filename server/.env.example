# Database configuration (SQLite default or PostgreSQL/MySQL for hosted DBs)
DATABASE_URL="file:./dev.db"

# JWT Secret for session authentication (Generate a secure random string for production)
JWT_SECRET="replace-with-a-secure-random-secret-key"

# Port on which the unified server runs
PORT=4000

# Node Environment ("development" or "production")
NODE_ENV="production"

# Razorpay Payment Gateway (Optional / Coming Soon)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Twilio SMS / WhatsApp Alerts (Optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
TWILIO_WHATSAPP_NUMBER=""
