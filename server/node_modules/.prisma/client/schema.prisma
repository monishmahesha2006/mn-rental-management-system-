generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  name         String?
  phone        String?
  createdAt    DateTime @default(now())

  properties         Property[]          @relation("OwnerProperties")
  tenancies          Tenancy[]           @relation("TenantTenancies")
  maintenanceTickets MaintenanceTicket[]
  notices            Notice[]
  vendors            Vendor[]
  tenantDocuments    TenantDocument[]
  serviceRequests    ServiceRequest[]
}

model Notice {
  id        String   @id @default(cuid())
  title     String
  content   String
  priority  String   @default("NORMAL") // NORMAL, IMPORTANT, URGENT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])
}

model Property {
  id        String   @id @default(cuid())
  name      String
  address   String
  city      String
  locality  String
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation("OwnerProperties", fields: [ownerId], references: [id])

  units    Unit[]
  expenses Expense[]
}

model Unit {
  id         String   @id @default(cuid())
  name       String
  rentAmount Int
  deposit    Int
  status     String   @default("AVAILABLE")
  createdAt  DateTime @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  tenancies          Tenancy[]
  occupants          Occupant[]
  maintenanceTickets MaintenanceTicket[]
  assets             Asset[]
}

model Tenancy {
  id          String    @id @default(cuid())
  startDate   DateTime
  endDate     DateTime?
  noticeStart DateTime?

  tenantId String
  tenant   User   @relation("TenantTenancies", fields: [tenantId], references: [id])

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])

  invoices          Invoice[]
  securityDeposit   SecurityDeposit?
  billingConfig     BillingConfig?
  inspectionRecords InspectionRecord[]
}

model BillingConfig {
  id         String   @id @default(cuid())
  rentDueDay Int      @default(5)
  billDueDay Int      @default(10)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenancyId String  @unique
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id])
}

model Occupant {
  id          String   @id @default(cuid())
  name        String
  age         Int?
  relation    String?
  phoneNumber String?
  aadharId    String?
  photoUrl    String?
  createdAt   DateTime @default(now())

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])
}

model Invoice {
  id                  String    @id @default(cuid())
  dueDate             DateTime
  paidAt              DateTime?
  status              String    @default("PENDING")
  totalAmount         Int
  paymentMethod       String? // "CASH" or "ONLINE"
  cashApprovalPending Boolean   @default(false)

  tenancyId String
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id])

  items             InvoiceItem[]
  paymentRefs       PaymentReference[]
  communicationLogs CommunicationLog[]
}

model InvoiceItem {
  id       String @id @default(cuid())
  label    String
  amount   Int
  category String

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
}

model SecurityDeposit {
  id                String @id @default(cuid())
  initialAmount     Int
  paintingDeduction Int    @default(0)
  cleaningDeduction Int    @default(0)
  otherDeduction    Int    @default(0)
  status            String @default("PENDING") // PENDING, VERIFIED

  tenancyId String  @unique
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id])
}

model MaintenanceTicket {
  id          String   @id @default(cuid())
  title       String
  description String
  category    String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])

  tenantId String?
  tenant   User?   @relation(fields: [tenantId], references: [id])
}

model CommunicationLog {
  id        String   @id @default(cuid())
  type      String
  channel   String
  message   String?
  createdAt DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
}

model PaymentReference {
  id          String   @id @default(cuid())
  provider    String // "RAZORPAY", "CASH"
  providerRef String // Razorpay order_id or payment_id
  status      String // "CREATED", "AUTHORIZED", "CAPTURED", "FAILED"
  amount      Int?
  currency    String?  @default("INR")
  method      String? // "upi", "card", "netbanking", "wallet"
  createdAt   DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
}

model Expense {
  id          String   @id @default(cuid())
  label       String
  amount      Int
  category    String // MAINTENANCE, TAX, UTILITY, OTHER
  date        DateTime @default(now())
  description String?

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
}

model Asset {
  id           String    @id @default(cuid())
  name         String
  category     String // APPLIANCE, FURNITURE, FIXTURE
  status       String    @default("GOOD") // GOOD, NEEDS_REPAIR, REPLACED
  purchaseDate DateTime?
  description  String?

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id])
}

model Vendor {
  id          String  @id @default(cuid())
  name        String
  contactName String?
  phone       String
  category    String // PLUMBER, ELECTRICIAN, CLEANER, ETC
  email       String?
  address     String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])
}

model TenantDocument {
  id        String   @id @default(cuid())
  name      String
  type      String // ID_PROOF, AGREEMENT, POLICE_VERIFICATION, OTHER
  url       String
  createdAt DateTime @default(now())

  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id])
}

model InspectionRecord {
  id     String   @id @default(cuid())
  type   String // MOVE_IN, MOVE_OUT, PERIODIC
  date   DateTime @default(now())
  notes  String?
  photos String? // JSON string or comma separated URLs
  status String   @default("PENDING")

  tenancyId String
  tenancy   Tenancy @relation(fields: [tenancyId], references: [id])
}

model ServiceRequest {
  id            String   @id @default(cuid())
  serviceType   String // CLEANING, DEEP_CLEANING, REPAIR
  preferredDate DateTime
  status        String   @default("PENDING") // PENDING, SCHEDULED, COMPLETED
  notes         String?

  tenantId String
  tenant   User   @relation(fields: [tenantId], references: [id])
}
